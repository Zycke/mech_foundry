<div class="mech-foundry tw-attack-card">
  <header class="tw-atk-head">
    <i class="fas fa-crosshairs"></i>
    <span class="tw-atk-weapon">{{weaponName}}</span>
    {{#if location}}<span class="tw-atk-loc">{{location}}</span>{{/if}}
  </header>

  {{#if targetName}}<div class="tw-atk-target">vs <strong>{{targetName}}</strong></div>{{/if}}

  <div class="tw-atk-tn">
    <span class="tw-atk-label">Target Number</span>
    <span class="tw-atk-tnval">{{tn}}+</span>
  </div>
  <div class="tw-atk-mods">
    {{#each mods}}<span class="tw-mod">{{this.label}} {{#if (gte this.value 0)}}+{{/if}}{{this.value}}</span>{{/each}}
  </div>

  <div class="tw-atk-roll {{#if hit}}hit{{else}}miss{{/if}}">
    <span class="tw-atk-dice">{{#each dice}}<span class="tw-die">{{this}}</span>{{/each}}</span>
    <span class="tw-atk-total">= {{rollTotal}}</span>
    {{#if outOfRange}}
    <span class="tw-atk-result oor">OUT OF RANGE</span>
    {{else}}
    <span class="tw-atk-result">{{#if hit}}HIT{{else}}MISS{{/if}}</span>
    <span class="tw-atk-margin">by {{margin}}</span>
    {{/if}}
  </div>

  {{#if hit}}<div class="tw-atk-dmg">Damage: <strong>{{damage}}</strong> — resolve hit location &amp; damage (next phase).</div>{{/if}}
</div>
