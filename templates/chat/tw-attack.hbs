<div class="mech-foundry tw-attack-card">
  <header class="tw-atk-head">
    <i class="fas fa-crosshairs"></i>
    <span class="tw-atk-weapon">{{weaponName}}</span>
    {{#if location}}<span class="tw-atk-loc">{{location}}</span>{{/if}}
  </header>

  {{#if targetName}}<div class="tw-atk-target">vs <strong>{{targetName}}</strong></div>{{/if}}

  <div class="tw-atk-tn">
    <span class="tw-atk-label">Target Number</span>
    <span class="tw-atk-tnval">{{tn}}+</span>
  </div>
  <div class="tw-atk-mods">
    {{#each mods}}<span class="tw-mod">{{this.label}} {{#if (gte this.value 0)}}+{{/if}}{{this.value}}</span>{{/each}}
  </div>

  <div class="tw-atk-roll {{#if hit}}hit{{else}}miss{{/if}}">
    <span class="tw-atk-dice">{{#each dice}}<span class="tw-die">{{this}}</span>{{/each}}</span>
    <span class="tw-atk-total">= {{rollTotal}}</span>
    {{#if outOfRange}}
    <span class="tw-atk-result oor">OUT OF RANGE</span>
    {{else}}
    <span class="tw-atk-result">{{#if hit}}HIT{{else}}MISS{{/if}}</span>
    <span class="tw-atk-margin">by {{margin}}</span>
    {{/if}}
  </div>

  {{#if hitResult}}
    {{#if hitResult.cluster}}
    <div class="tw-cluster">
      <span class="tw-hl-label">Cluster</span>
      <span class="tw-hl-dice">{{#each hitResult.clusterInfo.dice}}<span class="tw-die">{{this}}</span>{{/each}}</span>
      <span class="tw-cluster-hits"><strong>{{hitResult.clusterInfo.missiles}}</strong> / {{hitResult.clusterInfo.size}} hit · {{hitResult.total}} dmg</span>
    </div>
    {{/if}}

    {{#if hitResult.isMech}}
      {{#each hitResult.groups}}
      <div class="tw-hit-loc">
        <span class="tw-hl-dice">{{#each this.locDice}}<span class="tw-die">{{this}}</span>{{/each}}</span>
        <span class="tw-hl-loc">{{this.locLabel}}</span>
        <span class="tw-hl-dmg">{{this.damage}}</span>
        {{#if this.crit}}<span class="tw-hl-crit">CRIT CHECK</span>{{/if}}
      </div>
      {{#each this.events}}<div class="tw-hl-event">▸ {{this}}</div>{{/each}}
      {{#if this.destroyed}}<div class="tw-hl-destroyed">UNIT DESTROYED</div>{{/if}}
      {{#if this.overflow}}<div class="tw-hl-event">▸ {{this.overflow}} excess damage lost</div>{{/if}}
      {{/each}}
      {{#unless hitResult.applied}}<div class="tw-atk-dmg"><em>No permission — apply the above to {{hitResult.targetName}} manually.</em></div>{{/unless}}
    {{else}}
      <div class="tw-atk-dmg">
        <strong>{{hitResult.total}}</strong> damage{{#if hitResult.hasTarget}} to {{hitResult.targetName}}{{/if}} — resolve hit location manually{{#if hitResult.hasTarget}} (non-mech target){{/if}}.
      </div>
    {{/if}}
  {{else if hit}}
  <div class="tw-atk-dmg">Damage: <strong>{{damage}}</strong></div>
  {{/if}}
</div>
