<div class="mech-foundry tw-attack-card">
  <header class="tw-atk-head">
    <i class="fas fa-crosshairs"></i>
    <span class="tw-atk-weapon">{{weaponName}}</span>
    {{#if location}}<span class="tw-atk-loc">{{location}}</span>{{/if}}
  </header>

  {{#if targetName}}<div class="tw-atk-target">vs <strong>{{targetName}}</strong></div>{{/if}}

  <div class="tw-atk-tn">
    <span class="tw-atk-label">Target Number</span>
    <span class="tw-atk-tnval">{{tn}}+</span>
  </div>
  <div class="tw-atk-mods">
    {{#each mods}}<span class="tw-mod">{{this.label}} {{#if (gte this.value 0)}}+{{/if}}{{this.value}}</span>{{/each}}
  </div>

  <div class="tw-atk-roll {{#if hit}}hit{{else}}miss{{/if}}">
    <span class="tw-atk-dice">{{#each dice}}<span class="tw-die">{{this}}</span>{{/each}}</span>
    <span class="tw-atk-total">= {{rollTotal}}</span>
    {{#if outOfRange}}
    <span class="tw-atk-result oor">OUT OF RANGE</span>
    {{else}}
    <span class="tw-atk-result">{{#if hit}}HIT{{else}}MISS{{/if}}</span>
    <span class="tw-atk-margin">by {{margin}}</span>
    {{/if}}
  </div>

  {{#if hitResult}}
    {{#if hitResult.manual}}
    <div class="tw-atk-dmg">Damage <strong>{{hitResult.damage}}</strong> to {{hitResult.targetName}} — resolve location manually (non-mech target).</div>
    {{else}}
    <div class="tw-hit-loc">
      <span class="tw-hl-label">Hit Location</span>
      <span class="tw-hl-dice">{{#each hitResult.locDice}}<span class="tw-die">{{this}}</span>{{/each}}</span>
      <span class="tw-hl-loc">{{hitResult.locLabel}}</span>
      {{#if hitResult.crit}}<span class="tw-hl-crit">CRIT CHECK</span>{{/if}}
    </div>
    <div class="tw-atk-dmg">
      <strong>{{hitResult.damage}}</strong> damage to {{hitResult.targetName}}
      {{#unless hitResult.applied}}<em>(no permission — apply manually)</em>{{/unless}}
    </div>
    {{#each hitResult.events}}<div class="tw-hl-event">▸ {{this}}</div>{{/each}}
    {{#if hitResult.destroyed}}<div class="tw-hl-destroyed">UNIT DESTROYED</div>{{/if}}
    {{#if hitResult.overflow}}<div class="tw-hl-event">▸ {{hitResult.overflow}} excess damage lost</div>{{/if}}
    {{/if}}
  {{else if hit}}
  <div class="tw-atk-dmg">Damage: <strong>{{damage}}</strong></div>
  {{/if}}
</div>
