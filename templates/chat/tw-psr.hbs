{{!-- A roll card (Piloting / Driving / Control rolls, falls, skids, crashes …), outcome first. Built by rollCard() in tw-cards.mjs. --}}
<div class="mech-foundry tw-attack-card tw-v tw-psr-card">
  <div class="tw-v-head"><i class="fas {{#if icon}}{{icon}}{{else}}fa-person-falling{{/if}}"></i><span>{{title}}</span>{{#if round}}<span class="tw-v-round">{{round}}</span>{{/if}}</div>
  {{#if unitName}}<div class="tw-v-who">{{unitName}}</div>{{/if}}

  {{#if hasTally}}
  <div class="tw-v-tally">
    {{#if verdict}}<div><span class="v {{#if verdict.ok}}ok{{else}}no{{/if}}">{{verdict.text}}</span><span class="k">{{{verdict.roll}}}</span></div>{{/if}}
    {{#if hasDamage}}<div><span class="v">{{damage}}</span><span class="k">damage</span></div>{{/if}}
  </div>
  {{/if}}

  {{> "systems/mech-foundry/templates/chat/parts/tw-alerts.hbs" a=alerts}}
  {{#each notes}}<div class="tw-v-note">▸ {{this}}</div>{{/each}}
  {{#if stays}}<div class="tw-v-note">▸ Stays standing.</div>{{/if}}
  {{#if stood}}<div class="tw-v-note">▸ Back on its feet.</div>{{/if}}
  {{#if woke}}<div class="tw-v-note">▸ Regains consciousness.</div>{{/if}}
  {{#each units}}{{> "systems/mech-foundry/templates/chat/parts/tw-locs.hbs" rows=this.rows name=this.name}}{{/each}}

  {{#if lines.length}}
  <div class="tw-v-sec">Rolls</div>
  <div class="tw-v-list">
    {{#each lines}}{{> "systems/mech-foundry/templates/chat/parts/tw-roll-line.hbs" l=this}}{{/each}}
  </div>
  {{/if}}

  {{#if hasFrags}}
  <div class="tw-v-list tw-v-more">
    <details class="tw-v-w"><summary><span class="mark"></span><span class="wn"><span class="nm">Hit locations &amp; damage rolls</span></span><span class="roll"><span class="tw-v-chev">›</span></span></summary>
      <div class="tw-v-wd">
        {{#if fall}}<div class="tw-hl-event">▸ Facing roll {{fall.facingRoll}}: {{fall.facing}} · hits on the {{fall.location}} column</div>
        {{#if fall.frag}}{{> "systems/mech-foundry/templates/chat/parts/tw-hit-result.hbs" hr=fall.frag}}{{/if}}{{/if}}
        {{#if skidFrag}}{{> "systems/mech-foundry/templates/chat/parts/tw-hit-result.hbs" hr=skidFrag}}{{/if}}
        {{#each frags}}
        {{#if this.title}}<div class="tw-self-head">{{this.title}}</div>{{/if}}
        {{> "systems/mech-foundry/templates/chat/parts/tw-hit-result.hbs" hr=this}}
        {{/each}}
      </div>
    </details>
  </div>
  {{/if}}
</div>
