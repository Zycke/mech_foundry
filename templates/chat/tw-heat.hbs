{{!-- The heat phase for one unit, outcome first. Built by heatCard() in tw-cards.mjs. --}}
<div class="mech-foundry tw-attack-card tw-v tw-heat-card">
  <div class="tw-v-head"><i class="fas fa-fire"></i><span>Heat Phase</span>{{#if round}}<span class="tw-v-round">{{round}}</span>{{/if}}</div>
  {{#if unitName}}<div class="tw-v-who">{{unitName}}</div>{{/if}}

  <div class="tw-v-tally">
    <div><span class="v">{{newHeat}}</span><span class="k">heat</span></div>
    <div><span class="v">{{change}}</span><span class="k">this turn</span></div>
    <div><span class="v">+{{effects.toHit}}</span><span class="k">to-hit</span></div>
  </div>
  {{#unless aero}}<div class="tw-atk-mods tw-v-effects">
    <span class="tw-mod">Move −{{effects.mp}} MP</span>
    <span class="tw-mod">Shutdown {{effects.shutdown}}</span>
    <span class="tw-mod">Ammo {{effects.ammo}}</span>
  </div>{{/unless}}

  {{> "systems/mech-foundry/templates/chat/parts/tw-alerts.hbs" a=alerts}}
  {{#each notes}}<div class="tw-v-note">▸ {{this}}</div>{{/each}}
  {{> "systems/mech-foundry/templates/chat/parts/tw-locs.hbs" rows=rows name=unitName}}

  <div class="tw-v-sec">Details</div>
  <div class="tw-v-list">
    <details class="tw-v-w"><summary><span class="mark"></span><span class="wn"><span class="nm">Heat breakdown</span><span class="out">{{start}} → <b>{{newHeat}}</b></span></span><span class="roll"><span class="tw-v-chev">›</span></span></summary>
      <div class="tw-v-wd">
        <div class="tw-heat-lines">
          {{#each lines}}<div class="tw-heat-line"><span class="e">{{this.label}}</span><span class="v">{{#if (gte this.value 0)}}+{{/if}}{{this.value}}</span></div>{{/each}}
        </div>
        {{#each quiet}}<div class="tw-hl-event">▸ {{this}}</div>{{/each}}
      </div>
    </details>
    {{#each rollLines}}{{> "systems/mech-foundry/templates/chat/parts/tw-roll-line.hbs" l=this}}{{/each}}
    {{#if ammoFrag}}
    <details class="tw-v-w"><summary><span class="mark"></span><span class="wn"><span class="nm">Ammunition explosion</span></span><span class="roll"><span class="tw-v-chev">›</span></span></summary>
      <div class="tw-v-wd">{{> "systems/mech-foundry/templates/chat/parts/tw-hit-result.hbs" hr=ammoFrag}}</div>
    </details>
    {{/if}}
  </div>
</div>
