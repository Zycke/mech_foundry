{{!-- Per-weapon special rules (w = weapon row context, editable). See tw-weapons.mjs. --}}
<td class="w-special">
  {{#if w.special.guidable}}<select class="weapon-field w-guid" data-weapon-id="{{w.id}}" data-field="guidance" title="Fire control: Artemis IV +2 / Artemis V +3 on the cluster roll; Narc-capable missiles +2 against a target carrying a Narc pod" {{#unless editable}}disabled{{/unless}}><option value="" {{#unless w.guidance}}selected{{/unless}}>—</option><option value="artemis4" {{#if (eq w.guidance "artemis4")}}selected{{/if}}>Art IV</option><option value="artemis5" {{#if (eq w.guidance "artemis5")}}selected{{/if}}>Art V</option><option value="narc" {{#if (eq w.guidance "narc")}}selected{{/if}}>Narc</option></select>{{/if}}
  {{#if w.special.lbx}}<input type="number" min="0" class="weapon-field n w-clammo" data-weapon-id="{{w.id}}" data-field="clusterAmmo" value="{{w.clusterAmmo}}" placeholder="cl" title="LB-X cluster rounds (blank: cluster shots come from Rds)" {{#unless editable}}disabled{{/unless}} />{{/if}}
  {{#each w.special.munitions as |m|}}<input type="number" min="0" class="weapon-field n w-mun" data-weapon-id="{{../w.id}}" data-field="{{m.field}}" value="{{m.value}}" placeholder="{{m.short}}" title="{{m.label}} rounds carried (blank: none) — chosen in the fire dialog" {{#unless ../editable}}disabled{{/unless}} />{{/each}}
  <input type="number" class="weapon-field n w-th" data-weapon-id="{{w.id}}" data-field="toHit" value="{{w.special.toHitSet}}" placeholder="{{w.special.autoToHitText}}" title="The weapon's own to-hit modifier (pulse −2 …). Blank = from the equipment catalog ({{w.special.autoToHitText}})" {{#unless editable}}disabled{{/unless}} />
  {{#if w.jammed}}<span class="w-badge dmg" title="{{#if w.special.rotary}}Rotary AC: Unjam instead of attacking (2D6 ≥ Gunnery + 3){{else}}Jammed for the rest of the battle{{/if}}">JAMMED</span>{{#if editable}}{{#if w.special.rotary}}<button type="button" class="weapon-unjam" data-weapon-id="{{w.id}}" title="Try to unjam (takes the Weapon Attack Phase)"><i class="fas fa-screwdriver-wrench"></i></button>{{/if}}{{/if}}{{/if}}
  {{#if w.spent}}<span class="w-badge" title="One-shot weapon: fired">SPENT</span>{{/if}}
  {{#if editable}}{{#if w.special.clearable}}<a class="weapon-clear-state" data-weapon-id="{{w.id}}" title="Clear jam / reload (between battles)"><i class="fas fa-rotate-left"></i></a>{{/if}}{{/if}}
</td>
