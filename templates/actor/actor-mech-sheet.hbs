<div class="unit-sheet-content mech-sheet-content actor-sheet-content">

  {{!-- ===================== Header ===================== --}}
  <header class="mech-header">
    <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}" height="64" width="64" />
    <div class="header-id">
      <h1><input name="name" type="text" value="{{actor.name}}" placeholder="Mech Name" {{#unless editable}}disabled{{/unless}} /></h1>
      <div class="header-sub">
        <input class="sub-field" name="system.tonnage" type="number" min="0" value="{{system.tonnage}}" title="Tonnage" {{#unless editable}}disabled{{/unless}} /><span class="unit">t</span>
        <select class="sub-field" name="system.weightClass" title="Weight Class" {{#unless editable}}disabled{{/unless}}>
          <option value="">—</option>
          {{#each weightClasses}}<option value="{{this}}" {{#if (eq this ../system.weightClass)}}selected{{/if}}>{{this}}</option>{{/each}}
        </select>
        <input class="sub-field wide" name="system.techBase" type="text" value="{{system.techBase}}" placeholder="Tech Base" {{#unless editable}}disabled{{/unless}} />
      </div>
    </div>
    <div class="header-totals">
      <span class="tot-badge armor {{#if armorTotal.damaged}}dmg{{/if}}">ARMOR {{armorTotal.value}} / {{armorTotal.max}}</span>
      <span class="tot-badge struct {{#if structureTotal.damaged}}dmg{{/if}}">STRUCT {{structureTotal.value}} / {{structureTotal.max}}</span>
    </div>
  </header>

  {{!-- ===================== Tabs ===================== --}}
  <nav class="sheet-tabs">
    <a class="item" data-tab="status"><i class="fas fa-heart-pulse"></i> Status</a>
    <a class="item" data-tab="combat"><i class="fas fa-crosshairs"></i> Combat</a>
    <a class="item" data-tab="crits"><i class="fas fa-gears"></i> Crits &amp; Loadout</a>
    <a class="item" data-tab="details"><i class="fas fa-book"></i> Details</a>
  </nav>

  <section class="sheet-body">

    {{!-- ===================== STATUS ===================== --}}
    <div class="tab" data-tab="status">
      <div class="mf-panel">
        <h4>Armor / Structure <span class="hint">A = armor · S = internal · current / max</span></h4>
        <div class="mech-map">
          {{#each mechLocations as |column colName|}}
          <div class="mech-col">
            {{#each column}}
            <div class="locbox {{#if armor.damaged}}dmg{{/if}}">
              <div class="top"><span>{{label}}</span><span>{{code}}</span></div>
              <div class="loc-row a">
                <span class="tag">A</span>
                <span class="num"><input type="number" min="0" name="system.armor.{{key}}.value" value="{{armor.value}}" {{#unless ../../editable}}disabled{{/unless}} /><span class="mx">/{{armor.max}}</span></span>
                <span class="mini"><span style="width: {{armor.pct}}%"></span></span>
              </div>
              {{#if rear}}
              <div class="rear">rear <input type="number" min="0" class="rear-in" name="system.armor.{{rear.rearKey}}.value" value="{{rear.value}}" {{#unless ../../editable}}disabled{{/unless}} />/{{rear.max}}</div>
              {{/if}}
              <div class="loc-row s">
                <span class="tag">S</span>
                <span class="num"><input type="number" min="0" name="system.structure.{{key}}.value" value="{{structure.value}}" {{#unless ../../editable}}disabled{{/unless}} /><span class="mx">/{{structure.max}}</span></span>
                <span class="mini"><span style="width: {{structure.pct}}%"></span></span>
              </div>
            </div>
            {{/each}}
          </div>
          {{/each}}
        </div>
      </div>

      <div class="mf-grid2">
        <div class="mf-panel">
          <h4>Heat {{#if editable}}<button type="button" class="resolve-heat"><i class="fas fa-fire"></i> Resolve</button>{{/if}}</h4>
          <div class="heat">
            <div class="scale"><div class="fill" style="height: {{heat.pct}}%"></div></div>
            <div class="readout">
              <div class="heat-big">
                <input type="number" min="0" name="system.heat.value" value="{{heat.value}}" {{#unless editable}}disabled{{/unless}} /><small> / {{heat.scale}}</small>
              </div>
              <div class="eff-list">
                <div class="effrow {{#if heatEffects.mp}}active{{/if}}"><span class="e">Movement</span><span class="val">−{{heatEffects.mp}} MP</span></div>
                <div class="effrow {{#if heatEffects.toHit}}active{{/if}}"><span class="e">Firing (to-hit)</span><span class="val">+{{heatEffects.toHit}}</span></div>
                <div class="effrow {{#if heatEffects.shutdown.active}}active{{/if}}"><span class="e">Shutdown check</span><span class="val">{{heatEffects.shutdown.text}}</span></div>
                <div class="effrow {{#if heatEffects.ammo.active}}active{{/if}}"><span class="e">Ammo explosion</span><span class="val">{{heatEffects.ammo.text}}</span></div>
              </div>
            </div>
          </div>
        </div>

        <div class="mf-panel">
          <h4>Movement &amp; Status</h4>
          <div class="mf-stats">
            <label class="mf-stat"><span class="k">Walk</span><input type="number" min="0" name="system.movement.walk" value="{{movement.walk}}" {{#unless editable}}disabled{{/unless}} /></label>
            <div class="mf-stat"><span class="k">Run</span><span class="v derived">{{movement.run}}</span></div>
            <label class="mf-stat"><span class="k">Jump</span><input type="number" min="0" name="system.movement.jump" value="{{movement.jump}}" {{#unless editable}}disabled{{/unless}} /></label>
          </div>
          <div class="flags">
            <label class="chk"><input type="checkbox" name="system.conditions.shutdown" {{checked conditions.shutdown}} {{#unless editable}}disabled{{/unless}}> Shutdown</label>
            <label class="chk"><input type="checkbox" name="system.conditions.prone" {{checked conditions.prone}} {{#unless editable}}disabled{{/unless}}> Prone</label>
          </div>
        </div>
      </div>

      <div class="mf-panel">
        <h4>Pilot</h4>
        <div class="pilot">
          <div class="pic">{{#if pilotLinked}}<img src="{{pilotLinked.img}}" alt="" />{{else}}<i class="fas fa-user"></i>{{/if}}</div>
          <div class="info">
            <div class="pname-line">
              {{#if pilotLinked}}
                <span class="pname pilot-open" title="Open linked actor">{{pilotLinked.name}}</span>
                <span class="link linked"><i class="fas fa-link"></i> linked</span>
                {{#if editable}}<a class="pilot-unlink" title="Unlink"><i class="fas fa-unlink"></i></a>{{/if}}
              {{else}}
                <input class="pname-in" type="text" name="system.pilot.name" value="{{pilot.name}}" placeholder="Pilot name" {{#unless editable}}disabled{{/unless}} />
                {{#if editable}}<a class="link pilot-link"><i class="fas fa-link"></i> link PC/NPC</a>{{/if}}
              {{/if}}
            </div>
            <div class="consc" title="Consciousness / pilot hits">
              {{#each pilot.pips}}<span class="consc-pip {{#if this}}taken{{/if}}" data-level="{{add @index 1}}">{{add @index 1}}</span>{{/each}}
            </div>
          </div>
          <div class="skillpair">
            <div class="sk {{#if pilot.gunneryDerived}}derived{{/if}}"><span class="k">Gun</span>
              {{#if pilot.gunneryDerived}}<span class="skv" title="{{pilot.gunnerySource}}">{{pilot.gunnery}}</span>
              {{else}}<input type="number" min="0" name="system.pilot.gunnery" value="{{pilot.gunnery}}" {{#unless editable}}disabled{{/unless}} />{{/if}}
            </div>
            <div class="sk {{#if pilot.pilotingDerived}}derived{{/if}}"><span class="k">Pilot</span>
              {{#if pilot.pilotingDerived}}<span class="skv" title="{{pilot.pilotingSource}}">{{pilot.piloting}}</span>
              {{else}}<input type="number" min="0" name="system.pilot.piloting" value="{{pilot.piloting}}" {{#unless editable}}disabled{{/unless}} />{{/if}}
            </div>
          </div>
        </div>
      </div>
    </div>

    {{!-- ===================== COMBAT ===================== --}}
    <div class="tab" data-tab="combat">
      <div class="mf-panel">
        <h4>Weapons {{#if editable}}<button type="button" class="add-weapon"><i class="fas fa-plus"></i> Add</button>{{/if}}</h4>
        <table class="wt">
          <thead>
            <tr><th class="w-name">Weapon</th><th>Loc</th><th>Ht</th><th>Dmg</th><th title="Cluster/launcher size">Clus</th><th>S</th><th>M</th><th>L</th><th>Ammo Type</th><th>Rds</th><th></th></tr>
          </thead>
          <tbody>
            {{#each weapons}}
            <tr>
              <td class="w-name"><input type="text" class="weapon-field" data-weapon-id="{{id}}" data-field="name" value="{{name}}" placeholder="Weapon" {{#unless ../editable}}disabled{{/unless}} /></td>
              <td><input type="text" class="weapon-field loc" data-weapon-id="{{id}}" data-field="location" value="{{location}}" {{#unless ../editable}}disabled{{/unless}} /></td>
              <td><input type="number" min="0" class="weapon-field n" data-weapon-id="{{id}}" data-field="heat" value="{{heat}}" {{#unless ../editable}}disabled{{/unless}} /></td>
              <td><input type="number" min="0" class="weapon-field n" data-weapon-id="{{id}}" data-field="damage" value="{{damage}}" {{#unless ../editable}}disabled{{/unless}} /></td>
              <td><input type="number" min="0" class="weapon-field n" data-weapon-id="{{id}}" data-field="clusterSize" value="{{clusterSize}}" title="Cluster / launcher size (0 = single)" {{#unless ../editable}}disabled{{/unless}} /></td>
              <td><input type="number" min="0" class="weapon-field n" data-weapon-id="{{id}}" data-field="rangeS" value="{{rangeS}}" {{#unless ../editable}}disabled{{/unless}} /></td>
              <td><input type="number" min="0" class="weapon-field n" data-weapon-id="{{id}}" data-field="rangeM" value="{{rangeM}}" {{#unless ../editable}}disabled{{/unless}} /></td>
              <td><input type="number" min="0" class="weapon-field n" data-weapon-id="{{id}}" data-field="rangeL" value="{{rangeL}}" {{#unless ../editable}}disabled{{/unless}} /></td>
              <td><input type="text" class="weapon-field" data-weapon-id="{{id}}" data-field="ammoType" value="{{ammoType}}" placeholder="— none —" {{#unless ../editable}}disabled{{/unless}} /></td>
              <td><input type="number" min="0" class="weapon-field n" data-weapon-id="{{id}}" data-field="ammo" value="{{ammo}}" {{#unless ../editable}}disabled{{/unless}} /></td>
              <td class="w-actions">
                <button type="button" class="weapon-attack" data-weapon-id="{{id}}" title="Attack"><i class="fas fa-bolt"></i></button>
                {{#if ../editable}}<a class="duplicate-weapon" data-weapon-id="{{id}}" title="Duplicate"><i class="fas fa-clone"></i></a>{{/if}}
                {{#if ../editable}}<a class="remove-weapon" data-weapon-id="{{id}}" title="Remove"><i class="fas fa-trash"></i></a>{{/if}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{#unless weapons.length}}<p class="empty-notice">No weapons. Click "Add".</p>{{/unless}}
        <p class="logi-note">Ammo types feed the company Logistics roll-up. Attack buttons activate in the combat-automation phase.</p>
      </div>
    </div>

    {{!-- ===================== CRITS & LOADOUT ===================== --}}
    <div class="tab" data-tab="crits">
      <div class="mf-grid2">
        <div class="mf-panel">
          <h4>System Hits</h4>
          <div class="crit">
            {{#each systemHits}}
            <div class="c">
              <span>{{label}}</span>
              <span class="pips">
                {{#each pips}}<i class="sys-pip {{#if this}}on{{/if}}" data-sys="{{../key}}" data-level="{{add @index 1}}"></i>{{/each}}
              </span>
            </div>
            {{/each}}
          </div>
        </div>
        <div class="mf-panel">
          <h4>Heat Sinks</h4>
          <div class="mf-stats">
            <label class="mf-stat"><span class="k">Type</span>
              <select name="system.heatSinks.type" {{#unless editable}}disabled{{/unless}}>
                <option value="single" {{#if (eq heatSinks.type "single")}}selected{{/if}}>Single</option>
                <option value="double" {{#if (eq heatSinks.type "double")}}selected{{/if}}>Double</option>
              </select>
            </label>
            <label class="mf-stat"><span class="k">Count</span><input type="number" min="0" name="system.heatSinks.count" value="{{heatSinks.count}}" {{#unless editable}}disabled{{/unless}} /></label>
          </div>
        </div>
      </div>
      <div class="mf-panel">
        <h4>Critical Slots <span class="hint">combat auto-resolves crits against these</span>
          {{#if editable}}<button type="button" class="init-critslots"><i class="fas fa-wrench"></i> Init standard</button>{{/if}}
        </h4>
        {{#if hasCritSlots}}
        <div class="critslot-grid">
          {{#each critSlotLocations}}
          <div class="critslot-loc">
            <div class="csl-head">{{this.label}}</div>
            {{#if this.slots.length}}
            {{#each this.slots}}
            <div class="csl-row {{#if this.hit}}hit{{/if}}">
              <span class="csl-idx">{{this.index}}</span>
              <input type="text" class="critslot-field csl-name" data-loc="{{../key}}" data-index="{{subtract this.index 1}}" data-field="name" value="{{this.name}}" placeholder="—" {{#unless ../../editable}}disabled{{/unless}} />
              <select class="critslot-field csl-type" data-loc="{{../key}}" data-index="{{subtract this.index 1}}" data-field="type" {{#unless ../../editable}}disabled{{/unless}}>
                {{#each ../../slotTypes}}<option value="{{this.key}}" {{#if (eq this.key ../type)}}selected{{/if}}>{{this.label}}</option>{{/each}}
              </select>
              <input type="checkbox" class="critslot-hit" data-loc="{{../key}}" data-index="{{subtract this.index 1}}" title="Destroyed" {{checked this.hit}} {{#unless ../../editable}}disabled{{/unless}} />
            </div>
            {{/each}}
            {{else}}<div class="csl-empty">— no slots —</div>{{/if}}
          </div>
          {{/each}}
        </div>
        {{else}}
        <p class="logi-note">No critical slots yet. Click <strong>Init standard</strong> to lay out the standard biped components (engine, gyro, sensors, cockpit, actuators) plus empty slots you can name; combat will then resolve criticals to specific components automatically.</p>
        {{/if}}
      </div>
    </div>

    {{!-- ===================== DETAILS ===================== --}}
    <div class="tab" data-tab="details">
      <div class="mf-panel">
        <h4>Armor &amp; Structure — Maximums <span class="hint">enter once from the record sheet; the Status tab tracks current values against these</span></h4>
        <table class="setup-table">
          <thead><tr><th>Location</th><th>Armor</th><th>Rear</th><th>Structure</th></tr></thead>
          <tbody>
            {{#each setupLocations}}
            <tr>
              <td class="loc-name">{{label}} <span class="code">{{code}}</span></td>
              <td><input type="number" min="0" name="system.armor.{{key}}.max" value="{{armorMax}}" {{#unless ../editable}}disabled{{/unless}} /></td>
              <td>{{#if rearKey}}<input type="number" min="0" name="system.armor.{{rearKey}}.max" value="{{rearMax}}" {{#unless ../editable}}disabled{{/unless}} />{{else}}<span class="na">—</span>{{/if}}</td>
              <td><input type="number" min="0" name="system.structure.{{key}}.max" value="{{structMax}}" {{#unless ../editable}}disabled{{/unless}} /></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      <div class="mf-panel">
        <h4>Construction <span class="hint">stored as entered</span></h4>
        <div class="mf-stats wide">
          <label class="mf-stat"><span class="k">Era</span><input type="text" name="system.era" value="{{system.era}}" {{#unless editable}}disabled{{/unless}} /></label>
          <label class="mf-stat"><span class="k">Engine Type</span><input type="text" name="system.engineType" value="{{system.engineType}}" {{#unless editable}}disabled{{/unless}} /></label>
          <label class="mf-stat"><span class="k">Engine Rating</span><input type="number" min="0" name="system.engineRating" value="{{system.engineRating}}" {{#unless editable}}disabled{{/unless}} /></label>
          <label class="mf-stat"><span class="k">Cost (C-bills)</span><input type="number" min="0" name="system.cost" value="{{system.cost}}" {{#unless editable}}disabled{{/unless}} /></label>
          <label class="mf-stat"><span class="k">Battle Value</span><input type="number" min="0" name="system.bv" value="{{system.bv}}" {{#unless editable}}disabled{{/unless}} /></label>
        </div>
      </div>
      <div class="mf-panel">
        <h4>Notes / Biography</h4>
        <div class="editor-container">
          {{#if editable}}
          <prose-mirror name="system.biography" data-document-uuid="{{actor.uuid}}" value="{{system.biography}}" collaborate="false" toggled="true">{{{enrichedBiography}}}</prose-mirror>
          {{else}}{{{enrichedBiography}}}{{/if}}
        </div>
      </div>
    </div>

  </section>
</div>
